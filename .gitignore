# Byte-compiled / build artifacts
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/
.eggs/

# Virtualenvs
.venv/
venv/
env/

# Editors / OS junk
.vscode/
.idea/
.DS_Store

# Tests
.pytest_cache/
.coverage
htmlcov/

# scratch / experiment scratchpad
scratch/

# Slurm logs
slurm-*.out
logs/

# Machine-local, resolved-absolute env config (scripts/write-env-config.sh).
# See scripts/lib/env_config.sh for why this must never be committed.
scripts/env.local.conf

# Machine-local env-prefix receipts (scripts/create-env.sh output) —
# same rationale as env.local.conf above.
scripts/.env-prefix-*
